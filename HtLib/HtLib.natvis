<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">

  <Type Name="fixed_string_base&lt;char,*&gt;">
    <DisplayString>{elems._Elems,[sizeInElems]s}</DisplayString>
    <StringView>elems._Elems,[sizeInElems]s</StringView>
    <Expand>
      <Item Name="[size]">sizeInElems</Item>
      <Item Name="[capacity]">$T1</Item>
    </Expand>
  </Type>

  <Type Name="fixed_string_base&lt;wchar_t,*&gt;">
    <DisplayString>{elems._Elems,[sizeInElems]su}</DisplayString>
    <StringView>elems._Elems,[sizeInElems]su</StringView>
    <Expand>
      <Item Name="[size]">sizeInElems</Item>
      <Item Name="[capacity]">$T1</Item>
    </Expand>
  </Type>

  <Type Name="ht_array&lt;*,*&gt;">
    <DisplayString>{{ size={elemCount} }}</DisplayString>
    <Expand>
      <Item Name="[size]">elemCount</Item>
      <Item Name="[capacity]" Optional="true">mem._Mysize</Item>
      <Item Name="[capacity]" Optional="true">sizeof( mem._Elems ) / sizeof( mem._Elems[ 0 ] )</Item>
      <Item Name="[arena]" Optional="true">*pArena</Item>
      <ArrayItems Optional="true">
        <Size>elemCount</Size>
        <ValuePointer>mem._Mydata</ValuePointer>
      </ArrayItems>
      <ArrayItems Optional="true">
        <Size>elemCount</Size>
        <ValuePointer>mem._Elems</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

</AutoVisualizer>